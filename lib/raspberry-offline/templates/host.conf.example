#
# Workstation Toolkit
# Raspberry / ARM Linux Offline Backup
#

HOSTNAME=<HOSTNAME>
IP_ADDRESS=<IP_ADDRESS>

STORAGE_TYPE=<STORAGE_TYPE>
STORAGE_SIZE=<STORAGE_SIZE>

ROOT_DEVICE=<ROOT_DEVICE>
BOOT_PARTITION=<BOOT_PARTITION>
ROOT_PARTITION=<ROOT_PARTITION>

NETWORK_INTERFACE=<NETWORK_INTERFACE>
NETWORK_MODE=dhcp

BACKUP_MOUNT=/mnt/raspi-backups
BACKUP_TARGET=<NAS_IP>:<NAS_BACKUP_PATH>/<HOSTNAME>
NFS_VERSION=4.2

RETENTION=10

# Optional remote diagnostics (disabled when DIAG_SERVER is empty).
DIAG_SERVER=
DIAG_PORT=5514
